# Supabase project "LSPPPPPPPP"
SUPABASE_URL=https://fsljiocqekhvegflpbta.supabase.co
# Dashboard -> Project Settings -> API Keys -> "service_role" (legacy) or a "secret" key. Server only, never in the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Comma-separated. Add your Vercel domain when deployed, e.g. https://instajob.vercel.app
FRONTEND_ORIGINS=http://localhost:3000
# Optional: also allow Vercel preview URLs
FRONTEND_ORIGIN_REGEX=
MAX_NEGOTIATION_ROUNDS=8

# Optional: email notifications via Resend (https://resend.com). Leave empty for in-app only.
RESEND_API_KEY=
EMAIL_FROM=InstaJob <onboarding@resend.dev>
APP_URL=https://instajob.vercel.app
