{
 "project": {
  "raw_idea": "A booking app for home tutors in Kathmandu. Parents search tutors by subject and area, book weekly sessions and pay online. Tutors manage their schedule and see upcoming sessions.",
  "title": "Kathmandu Tutor Booking Platform",
  "questions": [
   {
    "why": "Building native mobile apps for iOS and Android doubles the development cost compared to a mobile-friendly website.",
    "answer": "Mobile-friendly website",
    "options": [
     "Mobile-friendly website",
     "Android & iOS mobile apps",
     "Android app only"
    ],
    "question": "How should parents and tutors access the platform?"
   },
   {
    "why": "Integrating local Nepalese wallets like eSewa or Khalti requires specific local business registration and different technical setups.",
    "answer": "Local wallets (eSewa, Khalti)",
    "options": [
     "Local wallets (eSewa, Khalti)",
     "Cash payment after class",
     "Both online wallets and cash"
    ],
    "question": "Which payment methods do you want to integrate?"
   },
   {
    "why": "Automated recurring subscriptions require complex payment gateway setups, whereas manual weekly booking is simpler and faster to build.",
    "answer": "Parents book and pay week-by-week",
    "options": [
     "Parents book and pay week-by-week",
     "Monthly advance payment",
     "Package bookings (e.g., 10 classes upfront)"
    ],
    "question": "How should the weekly booking and payment cycle work?"
   }
  ],
  "budget_max": 2800.0,
  "deadline_weeks": 6,
  "plan": {
   "risks": [
    {
     "risk": "The founder's budget of $2,800 is highly constrained for a custom booking and multi-wallet payment system (estimated at 110 hours, which averages ~$25/hr).",
     "mitigation": "The developer should focus strictly on the core MVP (Milestones 1-3). Milestone 4 can be simplified or deferred if budget limits are reached."
    },
    {
     "risk": "Delays in obtaining live merchant API keys for eSewa and Khalti due to local business registration requirements in Nepal.",
     "mitigation": "Build and test the entire payment flow using sandbox/test credentials. The app can be deployed to production in 'test mode' while the founder secures official merchant accounts."
    }
   ],
   "title": "Kathmandu Tutor Booking Platform",
   "summary": "A mobile-responsive web application connecting parents in Kathmandu with local home tutors. Parents can search by subject and neighborhood, book weekly slots, and pay securely via integrated local wallets (eSewa and Khalti), while tutors manage their schedules and track upcoming sessions.",
   "milestones": [
    {
     "id": "m1",
     "goal": "Parents can search and filter tutors by subject and Kathmandu area, and view tutor profiles.",
     "title": "Tutor Directory & Search",
     "priority": "must",
     "est_hours": 25,
     "deliverables": [
      "Database schema for Tutors, Subjects, and Areas",
      "Mobile-responsive landing page with search filters",
      "Tutor search results page with list cards",
      "Tutor profile detail page"
     ],
     "acceptance_criteria": [
      "Visiting the homepage displays dropdowns for Subject (e.g., Mathematics) and Area (e.g., Baneshwor, Lalitpur).",
      "Selecting filters and clicking search displays a list of matching tutors with their hourly rates.",
      "Clicking on a tutor card navigates to `/tutors/[id]` showing their bio, subjects, and rates."
     ]
    },
    {
     "id": "m2",
     "goal": "Tutors can set their weekly availability, and parents can book a pending session.",
     "title": "Auth & Weekly Schedule Booking",
     "priority": "must",
     "est_hours": 35,
     "deliverables": [
      "Supabase Auth integration for Parents and Tutors",
      "Tutor availability management dashboard",
      "Parent booking checkout flow (slot selection)"
     ],
     "acceptance_criteria": [
      "Tutors can log in and select available weekly time slots on `/dashboard/availability`.",
      "Logged-in parents can select an available slot on a tutor's profile and click 'Book' to create a pending booking.",
      "Pending bookings are saved in the database and visible on the parent's dashboard as 'Awaiting Payment'."
     ]
    },
    {
     "id": "m3",
     "goal": "Parents can pay for their weekly booking using local wallets to confirm the session.",
     "title": "eSewa & Khalti Payment Integration",
     "priority": "must",
     "est_hours": 30,
     "deliverables": [
      "eSewa payment gateway integration",
      "Khalti payment gateway integration",
      "Payment callback handlers to update booking status"
     ],
     "acceptance_criteria": [
      "Clicking 'Pay Now' on a pending booking redirects the user to the eSewa or Khalti sandbox payment page.",
      "Completing a successful sandbox transaction redirects the user back to `/booking/success`.",
      "The booking status updates from 'Awaiting Payment' to 'Confirmed' in the database immediately after successful payment verification."
     ]
    },
    {
     "id": "m4",
     "goal": "Tutors can view their upcoming confirmed sessions and both parties receive email alerts.",
     "title": "Tutor Dashboard & Notifications",
     "priority": "should",
     "est_hours": 20,
     "deliverables": [
      "Tutor upcoming sessions dashboard view",
      "Automated email notifications for bookings and payments"
     ],
     "acceptance_criteria": [
      "Tutors can log in and view a list of 'Confirmed' bookings with parent contact details and session times on `/dashboard/sessions`.",
      "A successful payment triggers an automated confirmation email to both the parent and the tutor."
     ]
    }
   ],
   "tech_stack": [
    "Next.js",
    "Tailwind CSS",
    "Supabase",
    "PostgreSQL",
    "eSewa SDK",
    "Khalti SDK"
   ],
   "assumptions": [
    "The founder will provide the list of Kathmandu areas and subjects for the initial database seed.",
    "Weekly bookings are paid one week at a time; automated recurring subscription billing is not required due to wallet limitations in Nepal.",
    "Tutor background verification and vetting will be handled manually offline by the platform owner."
   ],
   "out_of_scope": [
    "Native Android or iOS mobile applications.",
    "Automated recurring subscription charges (users must pay manually each week).",
    "In-app video calling or virtual classroom features."
   ],
   "target_users": "Parents seeking home tutors in Kathmandu, and local tutors looking for teaching engagements.",
   "required_skills": [
    "Next.js",
    "Postgres",
    "Supabase",
    "Tailwind CSS",
    "eSewa API",
    "Khalti API"
   ]
  }
